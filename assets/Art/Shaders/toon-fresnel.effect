// Toon + Fresnel rim outline for Egyptian Builder Runner.
// Unlit base color (optionally texture / vertex color), cheap fake directional shade,
// black Fresnel rim, skinning + instancing support, planar shadow pass.
CCEffect %{
  techniques:
  - name: opaque
    passes:
    - vert: toon-vs:vert
      frag: toon-fs:frag
      properties: &props
        mainTexture:    { value: white }
        mainColor:      { value: [1, 1, 1, 1], linear: true, editor: { type: color } }
        rimColor:       { value: [0, 0, 0, 1], linear: true, editor: { type: color } }
        rimPower:       { value: 2.5, target: rimParams.x, editor: { slide: true, range: [0.5, 8.0], step: 0.1 } }
        rimThreshold:   { value: 0.55, target: rimParams.y, editor: { slide: true, range: [0.0, 1.0], step: 0.01 } }
        rimSoftness:    { value: 0.06, target: rimParams.z, editor: { slide: true, range: [0.0, 0.5], step: 0.01 } }
        rimStrength:    { value: 1.0, target: rimParams.w, editor: { slide: true, range: [0.0, 1.0], step: 0.01 } }
        shadeDir:       { value: [-0.4, 0.8, 0.45], target: shadeParams.xyz }
        shadeStrength:  { value: 0.35, target: shadeParams.w, editor: { slide: true, range: [0.0, 1.0], step: 0.01 } }
        rimFadeStart:   { value: 14.0, target: rimFade.x, editor: { tooltip: 'Distance where the rim starts to fade out' } }
        rimFadeEnd:     { value: 32.0, target: rimFade.y, editor: { tooltip: 'Distance where the rim reaches rimFarStrength' } }
        rimFarStrength: { value: 0.0, target: rimFade.z, editor: { slide: true, range: [0.0, 1.0], step: 0.01 } }
        rimEdgesOnly:   { value: 0.0, target: rimFade.w, editor: { slide: true, range: [0.0, 1.0], step: 0.01, tooltip: '1 = rim only where the smoothed normal differs from the flat face (bevels), flat faces never darken' } }
    - &planar-shadow
      vert: planar-shadow-vs:vert
      frag: planar-shadow-fs:frag
      phase: planar-shadow
      propertyIndex: 0
      depthStencilState:
        depthTest: true
        depthWrite: false
        stencilTestFront: true
        stencilFuncFront: not_equal
        stencilPassOpFront: replace
        stencilRef: 0x80
        stencilReadMask: 0x80
        stencilWriteMask: 0x80
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
  - name: transparent
    passes:
    - vert: toon-vs:vert
      frag: toon-fs:frag
      depthStencilState:
        depthTest: true
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      properties: *props
}%

CCProgram toon-ubo %{
  uniform Constant {
    vec4 mainColor;
    vec4 rimColor;
    vec4 rimParams;
    vec4 shadeParams;
    vec4 rimFade;
  };
}%

CCProgram toon-vs %{
  precision highp float;
  #include <legacy/input-standard>
  #include <builtin/uniforms/cc-global>
  #include <legacy/decode-base>
  #include <legacy/local-batch>

  #if USE_VERTEX_COLOR
    in lowp vec4 a_color;
    out lowp vec4 v_color;
  #endif

  #if USE_TEXTURE
    out vec2 v_uv;
  #endif

  out vec3 v_worldPos;
  out vec3 v_worldNormal;

  vec4 vert () {
    StandardVertInput In;
    CCVertInput(In);

    mat4 matWorld, matWorldIT;
    CCGetWorldMatrixFull(matWorld, matWorldIT);

    vec4 worldPos = matWorld * In.position;
    v_worldPos = worldPos.xyz;
    v_worldNormal = normalize((matWorldIT * vec4(In.normal, 0.0)).xyz);

    #if USE_TEXTURE
      v_uv = a_texCoord;
    #endif
    #if USE_VERTEX_COLOR
      v_color = a_color;
    #endif

    return cc_matProj * (cc_matView * worldPos);
  }
}%

CCProgram toon-fs %{
  precision highp float;
  #pragma extension([GL_OES_standard_derivatives, __VERSION__ < 300])
  #include <builtin/uniforms/cc-global>
  #include <legacy/output-standard>
  #include <toon-ubo>

  in vec3 v_worldPos;
  in vec3 v_worldNormal;

  #if USE_TEXTURE
    in vec2 v_uv;
    uniform sampler2D mainTexture;
  #endif

  #if USE_VERTEX_COLOR
    in lowp vec4 v_color;
  #endif

  vec4 frag () {
    vec4 o = mainColor;

    #if USE_VERTEX_COLOR
      o.rgb *= SRGBToLinear(v_color.rgb);
      o.a *= v_color.a;
    #endif

    #if USE_TEXTURE
      vec4 texColor = texture(mainTexture, v_uv);
      texColor.rgb = SRGBToLinear(texColor.rgb);
      o *= texColor;
    #endif

    vec3 N = normalize(v_worldNormal);
    vec3 V = normalize(cc_cameraPos.xyz - v_worldPos);

    // Cheap fake directional shade so flat faces read in the greybox (set strength 0 when light is baked).
    float ndl = dot(N, normalize(shadeParams.xyz)) * 0.5 + 0.5;
    o.rgb *= mix(1.0, 0.55 + 0.45 * ndl, shadeParams.w);

    // Fresnel rim -> dark outline.
    float fres = pow(1.0 - clamp(dot(N, V), 0.0, 1.0), rimParams.x);
    // Anti-aliased transition: never narrower than ~1.5 px.
    float w = max(rimParams.z, fwidth(fres) * 1.5);
    float edge = smoothstep(rimParams.y - w, rimParams.y + w, fres) * rimParams.w;
    // Edges-only mode: keep the rim where the smoothed normal bends away from the flat face normal (bevels).
    vec3 faceN = normalize(cross(dFdx(v_worldPos), dFdy(v_worldPos)));
    float bend = 1.0 - abs(dot(N, faceN));
    edge *= mix(1.0, smoothstep(0.004, 0.03, bend), rimFade.w);
    // Fade out with distance: far rims are thinner than a pixel and only add noise.
    float dist = length(cc_cameraPos.xyz - v_worldPos);
    edge *= mix(1.0, rimFade.z, smoothstep(rimFade.x, rimFade.y, dist));
    o.rgb = mix(o.rgb, rimColor.rgb, edge);

    return CCFragOutput(o);
  }
}%

CCProgram planar-shadow-vs %{
  precision highp float;
  #include <legacy/input>
  #include <builtin/uniforms/cc-global>
  #include <legacy/decode-base>
  #include <legacy/local-batch>
  #include <builtin/uniforms/cc-shadow>
  #include <common/lighting/functions>

  out float v_dist;

  vec4 vert () {
    vec4 position;
    CCVertInput(position);
    mat4 matWorld, matWorldIT;
    CCGetWorldMatrixFull(matWorld, matWorldIT);
    vec3 worldPos = (matWorld * position).xyz;
    vec4 shadowPos = CalculatePlanarShadowPos(worldPos, cc_cameraPos.xyz, cc_mainLitDir.xyz, cc_planarNDInfo);
    position = CalculatePlanarShadowClipPos(shadowPos, cc_cameraPos.xyz, cc_matView, cc_matProj, cc_nearFar, cc_shadowWHPBInfo.w);
    v_dist = shadowPos.w;
    return position;
  }
}%

CCProgram planar-shadow-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-shadow>
  #include <legacy/output>

  in float v_dist;

  vec4 frag () {
    if (v_dist < 0.0)
      discard;
    return CCFragOutput(cc_shadowColor);
  }
}%
